      "id": "caddy-l4",
      "versions": [
        {
          "version": "0.1.0",
          "channel": "official",
          "publishedAt": "2026-09-16T23:36:24Z",
          "extensionApi": 1,
          "manifest": {
            "apiVersion": "gatebox/v2",
            "channel": "official",
            "contributions": {
              "backend": [
                {
                  "for": "non-http",
                  "impl": {
                    "template": "layer4 {\n{{- range .Rules }}\n{{- $r := . }}\n{{- range $r.Nets }}\n{{- $net := . }}\n{{- range $r.Ports }}\n\t{{ $net }}/:{{ . }} {\n\t\troute {\n\t\t\tproxy {{ $net }}/{{ $r.Upstream }}\n\t\t}\n\t}\n{{- end }}\n{{- end }}\n{{- end }}\n}",
                    "type": "template"
                  },
                  "point": "renderer",
                  "scope": "global"
                }
              ],
              "capabilities": [
                {
                  "data": {
                    "component": "caddy",
                    "feature": "github.com/mholt/caddy-l4"
                  },
                  "point": "component-variant"
                },
                {
                  "data": {
                    "class": "non-http",
                    "label": "TCP/UDP",
                    "networks": [
                      "tcp",
                      "udp"
                    ],
                    "requiresPrimaryDomain": false
                  },
                  "point": "proxy-protocols"
                }
              ],
              "ui": {
                "page": {
                  "type": "settings"
                },
                "slots": [
                  {
                    "from": "proxy-protocols",
                    "slot": "port-form.protocol-options"
                  }
                ]
              }
            },
            "id": "caddy-l4",
            "kind": "caddy-module",
            "name": "Caddy L4",
            "permissions": [
              {
